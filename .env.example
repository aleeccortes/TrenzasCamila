# Copiar como .env y reemplazar todos los valores antes de desplegar.
APP_PORT=8081
SERVER_PORT=8082
MYSQL_DATABASE=proycamila
MYSQL_HOST_PORT=3307
MYSQL_USER=proycamila_app
MYSQL_PASSWORD=reemplazar-clave-mysql
MYSQL_ROOT_PASSWORD=reemplazar-clave-root
DB_URL=jdbc:mysql://localhost:3307/proycamila?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=proycamila_app
DB_PASSWORD=reemplazar-clave-mysql
DB_POOL_SIZE=10
DB_MIN_IDLE=2
ADMIN_USERNAME=admin
ADMIN_PASSWORD=reemplazar-clave-admin
COOKIE_SECURE=false
MAVEN_OPTS=
CORS_ALLOWED_ORIGINS=
